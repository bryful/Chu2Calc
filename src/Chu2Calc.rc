#include <windows.h>
#include "Resource.h"

IDI_CHU2CALC ICON "Chu2Calc.ico"

1 VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "Chu2Calc - Fantasy Physics Calculator\0"
            VALUE "FileVersion", "1.1.1\0"
            VALUE "InternalName", "Chu2Calc\0"
            VALUE "OriginalFilename", "Chu2Calc.exe\0"
            VALUE "ProductName", "Chu2Calc\0"
            VALUE "ProductVersion", "1.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
